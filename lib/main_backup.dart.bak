import 'package:flutter/material.dart';

void main() {
  runApp(const RoadAlertApp());
}

class RoadAlertApp extends StatelessWidget {
  const RoadAlertApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'ROAD ALERT',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF1565C0),
        ),
        useMaterial3: true,
      ),
      home: const RoadAlertHome(),
    );
  }
}

class RoadAlertHome extends StatelessWidget {
  const RoadAlertHome({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('ROAD ALERT'),
        backgroundColor: const Color(0xFF1565C0),
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              Icons.warning_amber_rounded,
              size: 80,
              color: Colors.orange,
            ),
            const SizedBox(height: 20),
            const Text(
              'Bienvenue sur ROAD ALERT',
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 12),
            const Text(
              'Application de signalement des routes dégradées',
              textAlign: TextAlign.center,
            ),
          ],
        ),
      ),
    );
  }
}
